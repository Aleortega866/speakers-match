generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// ─── Contactos / Leads ───────────────────────────────────────────────────────

model Contact {
  id                      Int       @id @default(autoincrement())
  token                   String?   @unique @db.VarChar(8)
  nombre                  String    @db.VarChar(100)
  apellido                String    @db.VarChar(100)
  empresa                 String    @db.VarChar(200)
  email                   String    @db.VarChar(254)
  origen                  String    @default("outreach") @db.VarChar(20)
  enviado_at              DateTime?
  form_started_at         DateTime?
  form_completed_at       DateTime?
  fecha_evento            String?   @db.VarChar(20)
  calendly_booked_at      DateTime?
  correo_abandono_enviado Boolean   @default(false)
  match_answers           Json?
  created_at              DateTime  @default(now())
  client_matches          ClientMatch[]

  @@index([email])
  @@index([origen, form_started_at])
}

// ─── Preguntas del Match ──────────────────────────────────────────────────────

model MatchStep {
  id       Int               @id @default(autoincrement())
  orden    Int
  question String            @db.VarChar(500)
  columns  Int               @default(1)
  active   Boolean           @default(true)
  options  MatchStepOption[]

  @@index([active, orden])
}

model MatchStepOption {
  id     Int       @id @default(autoincrement())
  stepId Int
  step   MatchStep @relation(fields: [stepId], references: [id], onDelete: Cascade)
  label  String    @db.VarChar(300)
  orden  Int
  active Boolean   @default(true)

  @@index([stepId, active, orden])
}

// ─── Admin / Backoffice ───────────────────────────────────────────────────────

model AdminUser {
  id              Int             @id @default(autoincrement())
  email           String          @unique @db.VarChar(254)
  password_hash   String          @db.VarChar(255)
  role            String          @default("admin") @db.VarChar(20)
  active          Boolean         @default(true)
  created_at      DateTime        @default(now())
  updated_at      DateTime        @updatedAt
  admin_sessions  AdminSession[]
  admin_auditLogs AdminAuditLog[]
}

model AdminSession {
  id                 Int      @id @default(autoincrement())
  user_id            Int
  session_token_hash String   @unique @db.VarChar(255)
  expires_at         DateTime
  created_at         DateTime @default(now())
  ip                 String?  @db.VarChar(64)
  user_agent         String?  @db.VarChar(500)
  admin_user         AdminUser @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@index([expires_at])
}

model Speaker {
  id            Int           @id @default(autoincrement())
  nombre        String        @db.VarChar(150)
  especialidad  String        @db.VarChar(150)
  bio_short     String?       @db.VarChar(500)
  active        Boolean       @default(true)
  created_at    DateTime      @default(now())
  updated_at    DateTime      @updatedAt
  client_matches ClientMatch[]

  @@index([nombre])
}

model ClientMatch {
  id               Int      @id @default(autoincrement())
  client_id        Int
  speaker_id       Int
  match_score      Int
  top_skill        String?  @db.VarChar(120)
  skills_breakdown Json?
  created_at       DateTime @default(now())
  contact          Contact  @relation(fields: [client_id], references: [id], onDelete: Cascade)
  speaker          Speaker  @relation(fields: [speaker_id], references: [id], onDelete: Restrict)

  @@unique([client_id, speaker_id])
  @@index([client_id, match_score(sort: Desc)])
}

model AdminAuditLog {
  id            Int       @id @default(autoincrement())
  admin_user_id Int
  action        String    @db.VarChar(50)
  resource_type String?   @db.VarChar(50)
  resource_id   String?   @db.VarChar(100)
  metadata      Json?
  created_at    DateTime  @default(now())
  admin_user    AdminUser @relation(fields: [admin_user_id], references: [id], onDelete: Restrict)

  @@index([admin_user_id, created_at(sort: Desc)])
}

// ─── Outreach Mailchimp (lock + reconciliación post-send) ───────────────────

model OutreachRunLock {
  key        String   @id @db.VarChar(50)
  run_id     String   @db.VarChar(36)
  started_at DateTime
  expires_at DateTime
}

model OutreachReconciliation {
  id               Int      @id @default(autoincrement())
  run_id           String   @db.VarChar(36)
  campaign_id      String   @db.VarChar(50)
  contact_ids_json String   @db.Text
  status           String   @default("pending") @db.VarChar(20)
  created_at       DateTime @default(now())

  @@index([status, created_at])
}
